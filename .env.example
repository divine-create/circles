# ============================================================================
# CIRCLES PLATFORM — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env.local and provide values for external services.
# When NEXT_PUBLIC_SUPABASE_URL is omitted, Circles runs against an embedded
# PostgreSQL instance (@electric-sql/pglite) that executes supabase/migrations
# and enforces PostgreSQL Row-Level Security (RLS) locally.
# ============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration (Optional for local PGlite mode, required for production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session & Token Signing Secret (Used for signed HTTP-only session cookies in local Postgres mode)
CIRCLES_SESSION_SECRET=dev-only-replace-in-production-with-32-byte-secret-key

# Transactional Email via Resend (Optional — gracefully falls back to logged outbox in local dev)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Circles <notifications@circles.example.com>

# Local PostgreSQL Data Directory (for embedded PGlite storage)
PGLITE_DATA_DIR=.pgdata
