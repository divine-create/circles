# ============================================================================
# CIRCLES PLATFORM — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env.local and provide values for external services.
# When DATABASE_URL is omitted in local development/test, Circles runs
# against an embedded PostgreSQL instance (@electric-sql/pglite) that executes
# supabase/migrations and enforces PostgreSQL Row-Level Security (RLS) locally.
# In staging/production (NODE_ENV=production), DATABASE_URL and Supabase keys
# are strictly required unless ALLOW_EMBEDDED_POSTGRES_IN_PRODUCTION=true is set.
# ============================================================================

# Application Public Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase & Remote PostgreSQL Configuration (Required in staging/production)
# Obtain from Supabase Dashboard -> Project Settings -> API & Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct PostgreSQL connection string (port 5432 or Session Pooler port 5432)
# Must support transaction-scoped SET LOCAL ROLE and set_config() for RLS
DATABASE_URL=

# Optional Remote PostgreSQL Pool Tuning (Server-only)
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=false

# Explicit opt-in ONLY if running single-node embedded PostgreSQL in production evaluation
ALLOW_EMBEDDED_POSTGRES_IN_PRODUCTION=false

# Session & Token Signing Secret (Server-only; required in production: >=32 chars, >=10 distinct chars)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CIRCLES_SESSION_SECRET=dev-only-replace-in-production-with-32-byte-secret-key

# Transactional Email via Resend (Server-only; optional — falls back to logged outbox in local dev)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Circles <notifications@circles.example.com>

# Local PostgreSQL Data Directory (for embedded PGlite storage in local development)
PGLITE_DATA_DIR=.pgdata
